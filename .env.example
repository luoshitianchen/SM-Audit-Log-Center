# SM SM-Audit-Log-Center 环境配置示例（复制为 .env 使用）
SM_ENV=development
SM_ALLOWED_HOSTS=localhost,127.0.0.1
SM_MAX_REQUEST_BYTES=1048576
SM_RATE_WINDOW_SECONDS=60
SM_RATE_MAX_REQUESTS=600
# 内部写入令牌（生产必须设置强随机值）
SM_INTERNAL_API_KEY=
# JWT 签名密钥（启用后受保护接口要求 Bearer JWT）
SM_JWT_SECRET=
# 国密 SM4 主密钥：32 位十六进制（16 字节）。生产必须通过 KMS/HSM 注入，禁止写入仓库
SM4_KEY_HEX=
# 持久化数据库路径（留空则使用内存库，重启丢失）
SM_DATABASE_PATH=
# 集中审计中心地址（可选），配置后将审计事件异步转发
SM_AUDIT_CENTER_URL=
LOG_LEVEL=INFO
